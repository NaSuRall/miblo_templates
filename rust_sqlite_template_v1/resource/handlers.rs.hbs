pub async fn update(State(state): State<AppState>, Path(id): Path<i64>, Json(body): Json<Update>) -> Result<Json<{{name}}>, ApiError> {
    let has_changes = false{{#each fields}} || body.{{name}}.is_some(){{/each}};
    if !has_changes { return Err(ApiError::bad_request("Supply at least one field")); }
{{#each fields}}
{{#unless nullable}}
    if matches!(body.{{name}}, Some(None)) { return Err(ApiError::bad_request("{{name}} cannot be null")); }
{{/unless}}
{{#if string_like}}
    if let Some(Some(value)) = &body.{{name}} {
{{#if is_string}}
        if value.chars().count() > 255 { return Err(ApiError::bad_request("{{name}} must not exceed 255 characters")); }
{{else}}
        if value.len() > 65535 { return Err(ApiError::bad_request("{{name}} must not exceed 65535 bytes")); }
{{/if}}
    }
{{/if}}
{{/each}}
    let mut tx = state.db.begin_with("BEGIN IMMEDIATE").await?;
    // Reserve the SQLite writer before reading, including no-op updates.
    sqlx::query_scalar::<_, i64>("SELECT id FROM `{{table}}` WHERE id = ?")
        .bind(id).fetch_optional(&mut *tx).await?.ok_or_else(ApiError::not_found)?;
    let mut query = QueryBuilder::<Sqlite>::new("UPDATE `{{table}}` SET ");
    {
        let mut fields = query.separated(", ");
{{#each fields}}
        if let Some(value) = body.{{name}} {
            fields.push("`{{name}}` = ").push_bind_unseparated(value);
        }
{{/each}}
    }
    query.push(" WHERE id = ").push_bind(id);
    query.build().execute(&mut *tx).await?;
    let row = sqlx::query_as::<_, {{name}}>("SELECT * FROM `{{table}}` WHERE id = ?")
        .bind(id).fetch_one(&mut *tx).await?;
    tx.commit().await?;
    Ok(Json(row))
}

pub async fn delete(State(state): State<AppState>, Path(id): Path<i64>) -> Result<StatusCode, ApiError> {
    let result = sqlx::query("DELETE FROM `{{table}}` WHERE id = ?").bind(id).execute(&state.db).await?;
    if result.rows_affected() == 0 { return Err(ApiError::not_found()); }
    Ok(StatusCode::NO_CONTENT)
}

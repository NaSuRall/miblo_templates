use axum::{Json, extract::{Path, Query, State}, http::StatusCode};
use serde::Deserialize;
use sqlx::{Sqlite, QueryBuilder};
use crate::{AppState, error::ApiError};
use super::model::{Create, Update, {{name}}};

#[derive(Deserialize)]
pub struct Pagination {
    #[serde(default = "default_limit")]
    limit: u32,
    #[serde(default)]
    offset: u64,
}
fn default_limit() -> u32 { 20 }

pub async fn list(State(state): State<AppState>, Query(page): Query<Pagination>) -> Result<Json<Vec<{{name}}>>, ApiError> {
    if !(1..=100).contains(&page.limit) { return Err(ApiError::bad_request("limit must be between 1 and 100")); }
    let offset = i64::try_from(page.offset).map_err(|_| ApiError::bad_request("offset is too large"))?;
    let rows = sqlx::query_as::<_, {{name}}>("SELECT * FROM `{{table}}` ORDER BY id LIMIT ? OFFSET ?")
        .bind(page.limit).bind(offset).fetch_all(&state.db).await?;
    Ok(Json(rows))
}

pub async fn get_one(State(state): State<AppState>, Path(id): Path<i64>) -> Result<Json<{{name}}>, ApiError> {
    let row = sqlx::query_as::<_, {{name}}>("SELECT * FROM `{{table}}` WHERE id = ?")
        .bind(id).fetch_optional(&state.db).await?.ok_or_else(ApiError::not_found)?;
    Ok(Json(row))
}

